# Copy this file to .env for local development and fill in real values.
# In production (Vercel), set these under Project Settings -> Environment Variables
# instead of committing a .env file.

# Supabase/Postgres connection string, asyncpg driver, via the pgbouncer
# transaction pooler (port 6543 for Supabase).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# Upstash Redis REST credentials (used to store short-lived OTP codes)
UPSTASH_URL=https://your-db.upstash.io
UPSTASH_TOKEN=your-upstash-token
OTP_TTL_SECONDS=180

# Telegram bot used to deliver OTP codes
BOT_USERNAME=your_bot_username

# Comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*
DEBUG=false
